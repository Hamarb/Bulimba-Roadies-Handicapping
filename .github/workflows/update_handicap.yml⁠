name: Update Handicap Data
on:
  schedule:
    - cron: '0 15 * * 0' # Runs weekly on Tuesday
  workflow_dispatch:      # Allows you to click 'Run workflow' manually

jobs:
  update-data:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.9'

      - name: Install dependencies
        run: pip install pandas requests

      - name: Run handicap engine
        env:
          env:
            STRAVA_CLIENT_ID: ${{ secrets.STRAVA_CLIENT_ID }}
            STRAVA_CLIENT_SECRET: ${{ secrets.STRAVA_CLIENT_SECRET }}
            STRAVA_REFRESH_TOKEN: ${{ secrets.STRAVA_REFRESH_TOKEN }}
        run: python main_handicap_engine.py

      - name: Upload results
        uses: actions/upload-artifact@v4
        with:
          name: handicap-data
          path: bulimba_roadies_latest.csv


